{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch NestJS Debug",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "start:debug"],
      "console": "integratedTerminal",
      "restart": true /* This ensures the debugger re-attaches after restarting the app */,
      "cwd": "${workspaceFolder}",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      // ... rest of config
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "NODE_ENV": "debug", // This overrides whatever is in the .env file
        "ENABLE_LOGGING": "true" // This adds a new variable just for debugging
      }
    }
  ]
}
